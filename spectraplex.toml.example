port = 3000
host = "127.0.0.1"
database_url = "postgres://spectraplex:spectraplex@localhost:5432/spectraplex"
pool_size = 10
log_level = "info"
ingest_limit = 50
solana_rpc_url = "https://api.mainnet-beta.solana.com"
export_dir = "./exports"

# EVM trace API support (requires debug namespace on the RPC node).
# Most public RPC endpoints do NOT support this. Use a paid provider
# (Alchemy, Infura with Trace add-on) or a self-hosted archive node.
# evm_trace_enabled = false
# evm_trace_rpc_url = "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
