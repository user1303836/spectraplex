port = 3000
host = "127.0.0.1"
database_url = "postgres://spectraplex:spectraplex@localhost:5432/spectraplex"
pool_size = 10
log_level = "info"
ingest_limit = 50
export_dir = "./exports"

# Defaults cover Solana, Ethereum and Hyperliquid. Samples need no providers.
# Public RPCs are rate-limited; use your own endpoints for dependable indexing.
solana_rpc_url = "https://api.mainnet-beta.solana.com"
evm_rpc_url = "https://eth.llamarpc.com"

# Admin key comes from .env (generated by scripts/setup.sh).
# Optional streaming, trace enrichment and signed job callbacks:
# solana_grpc_url = "https://your-yellowstone-endpoint"
# solana_grpc_token = "..."
# evm_trace_enabled = true
# evm_trace_rpc_url = "https://your-trace-endpoint"
# callback_hmac_secret = "..."
# enable_v1_compat_writes = false

# Advanced: structured configuration replaces the defaults when BOTH networks
# and providers are declared. Declare every network you want enabled.
# For example, uncomment these two blocks to enable ONLY Base:
# [networks.base-mainnet]
# enabled = true
# [[providers]]
# network = "base-mainnet"
# kind = "rpc"
# url = "https://mainnet.base.org"
# capabilities = ["historical", "logs", "receipts", "balances"]

# Other network/provider combinations (repeat both blocks for each):
# solana-mainnet     / rpc  / https://api.mainnet-beta.solana.com / ["historical"]
# ethereum-mainnet   / rpc  / https://eth.llamarpc.com            / ["historical", "logs"]
# arbitrum-mainnet   / rpc  / https://arb1.arbitrum.io/rpc        / ["historical", "logs"]
# hypercore-mainnet  / rest / https://api.hyperliquid.xyz        / ["historical"]
# hypercore-mainnet  / ws   / wss://api.hyperliquid.xyz/ws       / ["stream"]
