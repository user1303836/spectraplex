port = 3000
host = "127.0.0.1"
database_url = "postgres://spectraplex:spectraplex@localhost:5432/spectraplex"
pool_size = 10
log_level = "info"
ingest_limit = 50
export_dir = "./exports"

# ---------------------------------------------------------------------------
# Legacy singleton fields (DEPRECATED — prefer structured provider config)
# ---------------------------------------------------------------------------
# These fields still work for backward compatibility. If `[networks.*]` and
# `[[providers]]` sections are present, the legacy fields are ignored.

solana_rpc_url = "https://api.mainnet-beta.solana.com"
# evm_rpc_url = "https://eth.llamarpc.com"
# solana_grpc_url = "https://your-yellowstone-endpoint"
# solana_grpc_token = "..."
# evm_trace_enabled = false
# evm_trace_rpc_url = "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"

# ---------------------------------------------------------------------------
# Structured network and provider configuration (V2, recommended)
# ---------------------------------------------------------------------------
# Enable the networks you want to index. Each network needs at least one
# provider entry with the capabilities your workload requires.
#
# When using structured config, API and CLI accept `network` as the primary
# parameter (e.g. "solana-mainnet", "base-mainnet"). The `chain` parameter
# still works as a backward-compatible alias that maps to a default network:
#   solana      -> solana-mainnet
#   ethereum    -> ethereum-mainnet
#   hyperliquid -> hypercore-mainnet
#
# Adapters are automatically constructed from the provider registry. CLI
# flags like --rpc and --grpc-url override the registry when provided.

# [networks.solana-mainnet]
# enabled = true
#
# [networks.ethereum-mainnet]
# enabled = true
#
# [networks.base-mainnet]
# enabled = true
#
# [networks.arbitrum-mainnet]
# enabled = true
#
# [networks.hypercore-mainnet]
# enabled = true

# -- Solana providers --

# [[providers]]
# network = "solana-mainnet"
# kind = "rpc"
# url = "https://api.mainnet-beta.solana.com"
# priority = 1
# capabilities = ["historical", "balances"]

# [[providers]]
# network = "solana-mainnet"
# kind = "grpc"
# url = "https://your-yellowstone-endpoint"
# token_env = "SOLANA_GRPC_TOKEN"
# priority = 1
# capabilities = ["stream"]

# -- Ethereum providers --

# [[providers]]
# network = "ethereum-mainnet"
# kind = "rpc"
# url = "https://eth.llamarpc.com"
# priority = 1
# capabilities = ["historical", "logs", "receipts", "balances"]

# [[providers]]
# network = "ethereum-mainnet"
# kind = "trace"
# url = "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
# priority = 2
# capabilities = ["debug_trace_transaction"]

# -- Base providers --

# [[providers]]
# network = "base-mainnet"
# kind = "rpc"
# url = "https://mainnet.base.org"
# priority = 1
# capabilities = ["historical", "logs", "receipts", "balances"]

# -- Arbitrum providers --

# [[providers]]
# network = "arbitrum-mainnet"
# kind = "rpc"
# url = "https://arb1.arbitrum.io/rpc"
# priority = 1
# capabilities = ["historical", "logs", "receipts", "balances"]

# -- Hyperliquid providers --

# [[providers]]
# network = "hypercore-mainnet"
# kind = "rest"
# url = "https://api.hyperliquid.xyz"
# priority = 1
# capabilities = ["historical"]

# [[providers]]
# network = "hypercore-mainnet"
# kind = "ws"
# url = "wss://api.hyperliquid.xyz/ws"
# priority = 1
# capabilities = ["stream"]

# ---------------------------------------------------------------------------
# Callback signing
# ---------------------------------------------------------------------------
# When set, all callback/webhook payloads are signed with HMAC-SHA256 and
# delivered with an X-Spectraplex-Signature header (sha256=<hex>).
#
# callback_hmac_secret = "your-secret-key"
